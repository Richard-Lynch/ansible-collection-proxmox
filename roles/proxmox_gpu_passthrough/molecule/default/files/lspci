#!/usr/bin/env bash
# Fake lspci for the role's device-presence gate. A generic bus: an integrated GPU, an
# Arc (Battlemage) card at 01:00.0, and non-display devices the class filter must exclude.
if [[ "$*" == *"-Dnn"* ]]; then
  echo '0000:00:00.0 Host bridge [0600]: Intel Corporation Host Bridge [8086:4660] (rev 02)'
  echo '0000:00:02.0 VGA compatible controller [0300]: Intel Corporation UHD Graphics 770 [8086:4680] (rev 0c)'
  echo '0000:01:00.0 VGA compatible controller [0300]: Intel Corporation Battlemage G21 [Intel Graphics] [8086:e20c]'
  echo '0000:02:00.0 Serial Attached SCSI controller [0107]: Broadcom / LSI SAS2308 [1000:0087] (rev 02)'
fi
exit 0
